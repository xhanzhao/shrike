<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net7.0 + RhinoCommon 8.0 so every Rhino 8 can load Shrike:
         Rhino 8.0-8.19 run .NET 7 and Rhino 8.20+ runs .NET 8, which also loads net7 plug-ins.
         Raising either one hides the Yak package from older Rhino 8 releases. -->
    <TargetFramework>net7.0-windows</TargetFramework>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>

    <RootNamespace>Shrike</RootNamespace>
    <AssemblyName>Shrike</AssemblyName>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>0.1.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Shrike</Company>
    <Product>Shrike</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Oldest Rhino 8 release. Yak uses this to set the minimum Rhino version. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Rhino 8 RegisterPanel overload can load an embedded icon by resource name.
       This avoids directly using System.Drawing.Icon in our source code. -->
  <ItemGroup>
    <None Remove="Resources\Shrike.ico" />
    <EmbeddedResource Include="Resources\Shrike.ico" LogicalName="Shrike.Resources.Shrike.ico" />
    <None Remove="Resources\PluginIcon.ico" />
    <EmbeddedResource Include="Resources\PluginIcon.ico" LogicalName="Shrike.Resources.PluginIcon.ico" />
  </ItemGroup>

  <!-- CRITICAL:
       Tool scripts/manifests/icons must exist next to the built .rhp.
       This copies Tools/** every time the project builds. -->
  <ItemGroup>
    <None Update="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
	<None Remove="Resources\DefaultToolIcon.png" />
  </ItemGroup>

  <ItemGroup>
	  
		<None Remove="Resources\NewToolIcon.png" />
		<EmbeddedResource
		  Include="Resources\NewToolIcon.png"
		  LogicalName="Shrike.Resources.NewToolIcon.png" />

	    <None Remove="Resources\RefreshIcon.png" />
		<EmbeddedResource
		  Include="Resources\RefreshIcon.png"
		  LogicalName="Shrike.Resources.RefreshIcon.png" />

	  <None Remove="Resources\ImportToolIcon.png" />
	  <EmbeddedResource Include="Resources\ImportToolIcon.png"
						LogicalName="Shrike.Resources.ImportToolIcon.png" />

	  <None Remove="Resources\DefaultToolIcon.png" />
	  <EmbeddedResource Include="Resources\DefaultToolIcon.png"
						LogicalName="Shrike.Resources.DefaultToolIcon.png" />

	  <None Remove="Resources\PanelOptionsIcon.png" />
	  <EmbeddedResource Include="Resources\PanelOptionsIcon.png"
						LogicalName="Shrike.Resources.PanelOptionsIcon.png" />
	  
   </ItemGroup>

</Project>
